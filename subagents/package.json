{
  "name": "@pi-minimal/subagents",
  "version": "0.1.0",
  "description": "Minimal sub-agents for pi: forks of the conversation that keep the prompt cache, with the parent's tools and model.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@earendil-works/pi-tui": "^1.4.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "check": "tsc -p . && node --test test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EviHex/pi-minimal.git",
    "directory": "subagents"
  },
  "license": "MIT",
  "files": [
    "index.ts",
    "child.ts",
    "fork.ts",
    "prompts.ts",
    "ui.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
