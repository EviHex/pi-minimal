{
  "name": "@pi-minimal/prompt-gate",
  "version": "0.2.0",
  "description": "Minimal prompt gate for pi: a prompt file is added to the system prompt only when its rule matches.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.2.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "check": "tsc -p ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EviHex/pi-minimal.git",
    "directory": "prompt-gate"
  },
  "license": "MIT",
  "files": [
    "index.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
